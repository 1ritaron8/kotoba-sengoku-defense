	call_deferred("run")

func check(value: bool, note: String) -> void:
	checks+=1
	if not value:
		failures.append(note)
		if failures.size()<=35: push_error("HISTORICAL_FIELD "+note)

func read_json(path: String):
	return JSON.parse_string(FileAccess.get_file_as_string(path))

func point(value: Dictionary) -> Vector2:
	return Vector2(float(value.x),float(value.y))

func immutable(stage: Dictionary) -> Dictionary:
	var result: Dictionary=stage.duplicate(true)
	for key in ["title","shortName","japanese","reading","description","color","accent","mode","icon","theme","background","historicalBattlefield","paths","objectives","buildZones","obstacles","water","bridges","landingIndex","stormZone","torches","walls","terraces","escortRoute","secondaryLandmarks","artTitle","artReview","tactics"]:
		result.erase(key)
	var operation: Dictionary=result.get("trait",{}).duplicate(true)
	for key in ["nameJP","reading","nameKO","descriptionKO"]: operation.erase(key)
	result.trait=operation
	result["pathIds"]=stage.paths.map(func(p): return [p.id,p.get("objectiveId","")])
	result["objectiveContracts"]=stage.objectives.map(func(o):
		var copy: Dictionary=o.duplicate(true)
		for key in ["x","y","label"]: copy.erase(key)
		return copy)
	result["zoneContracts"]=stage.buildZones.map(func(z):
		var copy: Dictionary=z.duplicate(true)
		for key in ["x","y","nameKo","label"]: copy.erase(key)
		return copy)
	result["postContracts"]=stage.tactics.groundPosts.map(func(z):
		var copy: Dictionary=z.duplicate(true)
		for key in ["pathIndex","segmentIndex","t","nameKo","x","y"]: copy.erase(key)
		return copy)
	return result

func make_game(stage: Dictionary, minutes: int=0) -> Node2D:
	var game: Node2D=Battle.new()
	root.add_child(game)
	game.set_process(false)
	game.configure_roster(catalog,TYPES,{})
	game.load_map(stage,minutes)
	game.set_seed(204)
	return game

func hold(game: Node2D) -> void:
	game.start_battle()
	game.enemies.clear()
	game.spawn_queue=["raider"]
	game.spawn_source_waves=[1]
	game.spawn_metadata=[{}]
	game.spawn_clock=100000.0

func await_production(game: Node2D) -> void:
	hold(game)
	for tick in range(300):
		if game.recruitment_queue.is_empty(): return
		game.advance_simulation(.025)
	check(false,str(game.config.id)+" production completes in the normal world clock")

func cost(type_name: String) -> int:
	for entry in catalog:
		if str(entry.id)==type_name: return int(entry.cost)
	return -1

func role_recruitment(stage: Dictionary, type_name: String) -> void:
	var game: Node2D=make_game(stage)
	game.gold=10000
	var wallet: int=game.gold
	var contract: Dictionary=game.placement_contract(type_name)
	check(game.begin_placement(type_name),str(stage.id)+" real "+type_name+" action starts")
	var position: Vector2=Vector2(-1,-1)
	if str(contract.deploymentKind)!="marching":
		check(game.gold==wallet and game.recruitment_queue.is_empty(),str(stage.id)+" "+type_name+" preview is unpaid")
		for zone in game.zones:
			position=game._zone_placement_hint(zone,type_name)
			if position.x>=0: break
		check(position.x>=0,str(stage.id)+" "+type_name+" has a typed legal deployment point")
		if position.x>=0:
			var preview: Dictionary=game.placement_preview(position)
			check(preview.valid and preview.placementRole==contract.placementRole,str(stage.id)+" "+type_name+" native preview matches actual role")
			check(game.ground_combat.land_segment_safe(position,position,.008),str(stage.id)+" "+type_name+" preview stays on actual land")
			check(game.place_unit(position.x,position.y),str(stage.id)+" "+type_name+" legal click commits")
			check(not game.place_unit(position.x,position.y),str(stage.id)+" "+type_name+" repeated click cannot commit again")
	if game.recruitment_queue.is_empty(): game.free();return
	check(game.gold==wallet-cost(type_name) and game.recruitment_queue.size()==1,str(stage.id)+" "+type_name+" paid order debits once")
	var reserved: Vector2=game.recruitment_queue[0].position
	await_production(game)
	check(game.units.size()==1 and game.recruitment_queue.is_empty(),str(stage.id)+" "+type_name+" real production creates one Lv1 actor")
	if not game.units.is_empty():
		var unit: Dictionary=game.units[0]
		check(str(unit.type)==type_name and int(unit.campaignLevel)==1,str(stage.id)+" actual generated actor type and permanent level remain unchanged")
		check(game.ground_combat.land_segment_safe(unit.position,unit.position,.008),str(stage.id)+" production actor occupies land")
		if str(contract.deploymentKind)=="marching":
			var start: Vector2=unit.position
			for tick in range(140):
				var previous: Vector2=unit.position
				game.advance_simulation(.025)
				check(game.ground_combat.land_segment_safe(previous,unit.position),str(stage.id)+" "+type_name+" actual march step cannot cross water/walls")
			check(unit.position.distance_to(start)>.008,str(stage.id)+" "+type_name+" leaves the base by walking after bounded gathering")
		else:
			check(unit.homePosition==reserved if unit.has("homePosition") else unit.position==reserved,str(stage.id)+" "+type_name+" keeps the chosen home/support site")
	game.free()

func map_contract(stage: Dictionary, original: Dictionary) -> void:
	var id: String=str(stage.id)
	check(immutable(stage)==immutable(original),id+" all balance/learning/save ids and role capacity/radii are unchanged")
	var history: Dictionary=stage.get("historicalBattlefield",{})
	check(not history.is_empty() and history.sourceStageId==id,id+" joins the verified geographic stage")
	if history.is_empty(): return
	check(str(history.plannedBackground)=="res://assets/battlefields/"+id+".png",id+" has a predictable future-art path")
	check(FileAccess.file_exists(str(stage.background)),id+" uses an existing fallback background before new art")
	check(history.legacyEncounterTheme==original.theme,id+" preserves the prior encounter theme separately")
	check(not str(stage.title).is_empty() and not str(stage.japanese).is_empty() and not str(stage.reading).is_empty(),id+" actual battlefield labels contain Japanese and reading")
	check(stage.paths.size()==original.paths.size() and stage.objectives.size()==original.objectives.size(),id+" lane/objective counts and economy contract are preserved")
	check(history.landmarkLabels.size()>=3,id+" image generation has individually authored major terrain anchors")
	for landmark in history.landmarkLabels:
		var p: Vector2=point(landmark)
		check(p.is_finite() and p.x>=0 and p.x<=1 and p.y>=0 and p.y<=1,id+" landmark normalized position is finite and bounded")
		check(float(landmark.scale.w)>0 and float(landmark.scale.h)>0,id+" landmark size is explicit")
	var source: String=JSON.stringify(stage)
	var game: Node2D=make_game(stage)
	check(game.paths.size()==stage.paths.size(),id+" actual load creates every authored lane")
	check(game.ground_combat.march_bases.size()==stage.paths.size(),id+" every lane provides a real marching base")
	var sites_by_path: Dictionary={}
	for site in game.ground_combat.ambush_sites:
		sites_by_path[int(site.pathIndex)]=true
		check(not game._on_road(site.position) and game.ground_combat.land_segment_safe(site.position,site.entryPosition),id+" actual ninja site and approach remain outside roads on land")
	check(sites_by_path.size()==game.paths.size(),id+" every enemy lane has an independent external ninja site")
	for feature in history.get("waterFeatures",[]):
		var water_rect: Rect2=Rect2(float(feature.x),float(feature.y),float(feature.w),float(feature.h))
		for site in game.ground_combat.ambush_sites:
			check(not water_rect.has_point(site.position) and not water_rect.has_point(site.entryPosition),id+" ninja sites avoid additional depicted water "+str(feature.id))
		for zone in game.zones:
			check(not water_rect.has_point(zone.position),id+" deployment zone avoids additional depicted water "+str(feature.id))
		for path in game.paths:
			for p in path.points:check(not water_rect.has_point(p),id+" path points avoid additional depicted water "+str(feature.id))
			for i in range(path.points.size()-1):
				check(game.ground_combat._water_intersection(path.points[i],path.points[i+1],water_rect).x<0,id+" route segments avoid additional depicted water "+str(feature.id))
	for path_index in range(game.paths.size()):
		var path: Dictionary=game.paths[path_index]
		var previous: Vector2=path.points[0]
		var objective: Dictionary=game._objective(str(path.get("objectiveId","")))
		check(not objective.is_empty() and path.points[-1].distance_to(objective.position)<.0001,id+" lane endpoint reaches its actual associated objective")
		for p in path.points:
			check(p.is_finite() and p.x>=0 and p.x<=1 and p.y>=0 and p.y<=1,id+" route normalized point is finite and bounded")
			check(game.ground_combat.land_segment_safe(previous,p),id+" complete native route avoids water and blocking obstacles")
			previous=p
		check(game.ground_combat.land_route_safe(path_index,0,float(game.ground_combat.cumulative[path_index][-1])),id+" full authored march route is land-safe")
		if int(stage.stageNumber)>=15:
			var station: Dictionary=game._fortification_position(path_index)
			check(not station.is_empty(),id+" unlocked enemy fort has a reachable land anchor on lane "+str(path_index))
	var zones: int=0
	for zone in game.zones:
		if str(zone.placementRole)=="ambush":continue
		var type_name: String="archer" if str(zone.placementRole)=="ranged" else "monk"
		var hint: Vector2=game._zone_placement_hint(zone,type_name)
		check(hint.x>=0,id+" authored "+str(zone.get("id","zone"))+" retains a legal "+type_name+" cursor")
		if hint.x>=0: check(game.ground_combat.land_segment_safe(hint,hint),id+" authored fixed deployment lies on land")
		zones+=1
	check(zones==stage.buildZones.size()+stage.tactics.groundPosts.size(),id+" native deployment zones preserve all authored positions")
	if stage.has("water"):
		var water: Dictionary=stage.water
		var middle: Vector2=Vector2(float(water.x)+float(water.w)*.5,float(water.y)+float(water.h)*.5)
		check(not game.ground_combat.land_segment_safe(middle,middle),id+" functional water remains excluded from land movement")
		game.begin_placement("ninja")
		check(not game.placement_preview(middle).valid,id+" ninja cannot deploy into functional water")
		game.cancel_recruit()
	check(JSON.stringify(stage)==source,id+" native map loading does not mutate authored geography")
	observations[id]={"title":stage.title,"theme":stage.theme,"legacyTheme":history.legacyEncounterTheme,"lanes":game.paths.size(),"ninjaSites":game.ground_combat.ambush_sites.size(),"zones":zones,"missionField":history.missionField,"season":history.season.key}
	game.free()
	if OS.get_cmdline_user_args().has("--geometry-only"): return
	for type_name in TYPES: role_recruitment(stage,str(type_name))
	for minutes in [5,10,20]:
		game=make_game(stage,minutes)
		var snapshot: Dictionary=game.snapshot()
		check(snapshot.battleMinutes==minutes and is_equal_approx(float(snapshot.battleTargetSeconds),float(minutes)*60),id+" shared "+str(minutes)+" minute clock remains intact")
		check(game.config.id==stage.id and game.config.recommendedWords==stage.recommendedWords,id+" duration mode retains the same progression/learning ids")
		game.free()

func repeated_region(maps: Array, earlier: String, later: String) -> void:
	var a: Dictionary={}
	var b: Dictionary={}
	for stage in maps:
		if str(stage.id)==earlier:a=stage
		if str(stage.id)==later:b=stage
	if not a.has("historicalBattlefield") or not b.has("historicalBattlefield"):return
	var ah: Dictionary=a.historicalBattlefield
	var bh: Dictionary=b.historicalBattlefield
	check(ah.missionField.locationId==bh.missionField.locationId,later+" stays at the same field location")
	for landmark in ah.landmarkLabels:
		for other in bh.landmarkLabels:
			if landmark.id==other.id:
				check(landmark.x==other.x and landmark.y==other.y and landmark.scale==other.scale,later+" preserves shared terrain anchor "+str(landmark.id))
	check(not bh.traces.is_empty(),later+" visibly records the prior phase as annotated game traces")

func support_contract(stage: Dictionary, original: Dictionary, plan: Dictionary) -> void:
	var id: String=str(stage.id)
	check(immutable(stage)==immutable(original),id+" final map preserves all immutable balance/learning/save contracts")
	var history: Dictionary=stage.historicalBattlefield
	check(history.phaseJP==stage.japanese and history.phaseReading==stage.reading,id+" Japanese battlefield phase and reading are consistent")
	check(not stage.japanese.is_empty() and not stage.reading.is_empty(),id+" historical Japanese phase has a readable kana title")
	var anchors: Dictionary=history.get("learningSupportAnchors",{})
	var game: Node2D=make_game(stage)
	# Compare actual native encounter composition against the old map using the
	# same engine. Coordinates may change; enemy kind/source wave budgets may not.
	var new_schedule: Array=game._build_base_wave_schedule(int(stage.totalWaves))
	var current_config: Dictionary=game.config
	game.config=original.duplicate(true)
	var original_schedule: Array=game._build_base_wave_schedule(int(original.totalWaves))
	game.config=current_config
	check(new_schedule==original_schedule,id+" legacy encounter theme preserves the exact native original wave roster")
	hold(game)
	var wallet: int=game.gold
	var mission_ids: Dictionary={}
	var mission_positions: Array=[]
	for mission in plan.get("missions",[]):
		var mission_id: String=str(mission.id)
		mission_ids[mission_id]=true
		var original_position: Dictionary=mission.get("action",{}).get("position",{})
		var selected: Dictionary=anchors.get(mission_id,original_position)
		var position: Vector2=point(selected)
		check(position.is_finite() and position.x>=0 and position.x<=1 and position.y>=0 and position.y<=1,id+" support "+mission_id+" has bounded coordinates")
		check(game.ground_combat.land_segment_safe(position,position),id+" support "+mission_id+" lies on actual land")
		for feature in history.get("waterFeatures",[]):
			var water: Rect2=Rect2(float(feature.x),float(feature.y),float(feature.w),float(feature.h))
			check(not water.has_point(position),id+" support "+mission_id+" avoids every depicted water channel")
		if anchors.has(mission_id):
			var near: bool=false
			for zone in game.zones:
				if str(zone.placementRole)!="ambush" and position.distance_to(zone.position)<=float(zone.r)+.0001:near=true
			check(near,id+" remapped support reaches a usable friendly deployment zone")
		var result: Dictionary=game.apply_learning_support(position,false,mission_id)
		check(result.get("ok",false) and is_equal_approx(float(result.get("x",-1)),position.x) and is_equal_approx(float(result.get("y",-1)),position.y),id+" real support API consumes the selected anchor")
		check(is_equal_approx(float(result.get("duration",0)),12.0) and is_equal_approx(float(result.get("unitDamageFactor",0)),1.15),id+" remapping preserves full support strength/duration")
		var supports: int=game.learning_supports.size()
		check(not game.apply_learning_support(position,false,mission_id).get("ok",true) and game.learning_supports.size()==supports,id+" duplicate support receipt cannot add a second effect")
		var hinted: Dictionary=game.apply_learning_support(position,true,mission_id+":hint")
		check(hinted.get("ok",false) and is_equal_approx(float(hinted.get("duration",0)),6.0) and is_equal_approx(float(hinted.get("unitDamageFactor",0)),1.08),id+" hinted support strength/duration remains unchanged")
		mission_positions.append({"id":mission_id,"original":original_position,"selected":selected,"remapped":anchors.has(mission_id)})
	for key in anchors:check(mission_ids.has(key),id+" anchor is keyed by a real stable mission ID")
	check(game.gold==wallet,id+" coordinate remapping does not alter the reward wallet")
	observations[id]={"title":stage.title,"phaseJP":stage.japanese,"anchors":anchors,"missions":mission_positions,"legacyRosterPreserved":new_schedule==original_schedule}
	game.free()

func run() -> void:
	catalog=read_json("res://native/units.json").units
	var maps: Array=read_json("res://native/maps.json")
	var baseline: Array=JSON.parse_string(BASELINE_JSON)
	var count: int=10 if OS.get_cmdline_user_args().has("--first-ten") else maps.size()
	var first: int=0
	for argument in OS.get_cmdline_user_args():
		if str(argument).begins_with("--through="): count=clampi(int(str(argument).trim_prefix("--through=")),1,maps.size())
		if str(argument).begins_with("--from="): first=clampi(int(str(argument).trim_prefix("--from="))-1,0,count-1)
	var plans: Dictionary=read_json("res://native/learning_plans.json").stages
	for i in range(first,count):
		if OS.get_cmdline_user_args().has("--supports-only"): support_contract(maps[i],baseline[i],plans[str(maps[i].id)])
		else: map_contract(maps[i],baseline[i])
	if OS.get_cmdline_user_args().has("--supports-only"):
		var main_source: String=FileAccess.get_file_as_string("res://native/main.gd")
		check(main_source.contains("learningSupportAnchors") and main_source.contains("support_anchors.get"),"Production Main consumes mission-keyed support anchors before the legacy position")
		var curriculum: Dictionary=read_json("res://native/curriculum.json")
		var word_ids: Dictionary={}
		var lesson_ids: Dictionary={}
		for tier in ["basic","beginner","intermediate","advanced"]:
			for lesson in curriculum[tier]:
				lesson_ids[str(lesson.id)]=true
				for word in lesson.newWords:
					check(not word_ids.has(str(word.id)),"900-word source retains unique word IDs")
					word_ids[str(word.id)]=true
		check(word_ids.size()==900 and lesson_ids.size()==40,"Full 900-word and 40-lesson curriculum remains intact")
		var missions: Dictionary={}
		for stage_id in plans:
			check(lesson_ids.has(str(plans[stage_id].lessonId)),"Stable map-to-lesson relation remains valid")
			for mission in plans[stage_id].missions:
				check(not missions.has(str(mission.id)),"120 authored missions retain unique stable IDs")
				missions[str(mission.id)]=true
		check(missions.size()==120 and plans.size()==40,"120 context missions remain available on the same 40 stage IDs")
	repeated_region(maps,"basic-temple","basic-snow")
	if count>20:repeated_region(maps,"intermediate-forest","intermediate-town")
	if count>26:
		repeated_region(maps,"intermediate-convoy","intermediate-temple")
		repeated_region(maps,"intermediate-convoy","intermediate-snow")
		var news: Dictionary=maps[26].historicalBattlefield
		check(news.missionField.locationId=="takamatsu-1582" and news.historicalEventOrigin.locationId!="takamatsu-1582","Honnoji news keeps the player at Takamatsu and the historical event origin in Kyoto")
	var report: Dictionary={"checks":checks,"failures":failures,"observations":observations,"testedStages":count-first,"firstStage":first+1,"lastStage":count,"gpuUsed":false,"sourceGeometryPolicy":"qualitative historical terrain, authored normalized gameplay layout"}
	var path: String="user://qa_historical_battlefields_packed.json" if OS.get_cmdline_user_args().has("--packed") else ("res://tests/qa_historical_battlefields_supports.json" if OS.get_cmdline_user_args().has("--supports-only") else "res://tests/qa_historical_battlefields.json")
	var output: FileAccess=FileAccess.open(path,FileAccess.WRITE)
	output.store_string(JSON.stringify(report,"  "));output.close()
	print("HISTORICAL_BATTLEFIELDS ",checks," checks / ",failures.size()," failures / stages ",count)
	quit(0 if failures.is_empty() else 1)
