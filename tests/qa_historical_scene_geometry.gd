var checks: int=0
var failures: Array[String]=[]
var observations: Array=[]
var catalog: Array=[]
var scope: String=""

func _initialize() -> void:
	Engine.max_fps=120
	call_deferred("run")

func check(value: bool,note: String) -> void:
	checks+=1
	if not value:
		failures.append(scope+": "+note)
		if failures.size()<=30: push_error("HISTORICAL_SCENE "+scope+": "+note)

func point(data: Dictionary) -> Vector2:
	return Vector2(float(data.get("x",0)),float(data.get("y",0)))

func make_game(stage: Dictionary,minutes: int=0) -> Node2D:
	var game: Node2D=Battle.new()
	root.add_child(game)
	game.set_process(false)
	game.configure_roster(catalog,TYPES,{})
	game.load_map(stage,minutes)
	game.set_seed(204)
	return game

func hold(game: Node2D) -> void:
	game.start_battle()
	game.enemies.clear()
	game.spawn_queue=["raider"]
	game.spawn_source_waves=[1]
	game.spawn_metadata=[{}]
	game.spawn_clock=100000.0

func wait_for_production(game: Node2D) -> void:
	hold(game)
	for tick in range(300):
		if game.recruitment_queue.is_empty(): return
		game.advance_simulation(.025)
	check(false,"Production finishes on the ordinary simulation clock")

func immutable(stage: Dictionary) -> Dictionary:
	var result: Dictionary={}
	for key in ["id","tier","tierIndex","stageNumber","level","difficulty","totalWaves","initialGold","recruitCost","unitLimit","recommendedWords","reviewWords","unlocked","music","trait","mode","objectives","water","bridges","obstacles","escortRoute"]:
		result[key]=stage.get(key,null)
	result["paths"]=stage.paths.map(func(p): return {"id":p.id,"objectiveId":p.objectiveId})
	return result

func area_checks(game: Node2D,stage: Dictionary) -> void:
	check(stage.buildZones.size()>=12 and stage.buildZones.size()<=16,"12–16 distinct authored firing areas")
	check(stage.tactics.groundPosts.size()>=8 and stage.tactics.groundPosts.size()<=12,"8–12 actual frontline/support sites")
	var area_hints: int=0
	for index in range(stage.buildZones.size()):
		var authored: Dictionary=stage.buildZones[index]
		var center: Vector2=point(authored)
		check(not game._eligible_zone(center,"archer").is_empty(),"Firing area center is natively placeable "+str(index))
		for spoke in range(48):
			var edge: Vector2=center+Vector2.from_angle(TAU*spoke/48.0)*float(authored.r)
			check(game.ground_combat.land_segment_safe(edge,edge,0),"Complete firing area stays off water/blocking terrain "+str(index)+"/"+str(spoke))
		var hint: Vector2=game._zone_placement_hint(game.zones[index],"archer")
		if hint.x>=0: area_hints+=1
	check(area_hints>=12,"Expanded areas supply at least12 independent native placement hints, observed "+str(area_hints))
	var ground_hints: int=0
	for zone in game.zones:
		if str(zone.get("placementRole",""))!="ground": continue
		var hint: Vector2=game._zone_placement_hint(zone,"gunner")
		if hint.x>=0:
			ground_hints+=1
			check(game.ground_combat.land_segment_safe(hint,hint,.008),"Actual gunner/guard/support hint stays on land")
	check(ground_hints>=8,"Ground deployment supplies at least8 actual hints, observed "+str(ground_hints))
	observations.append({"stageId":stage.id,"firingAreas":stage.buildZones.size(),"nativeFiringHints":area_hints,"groundPosts":stage.tactics.groundPosts.size(),"nativeGroundHints":ground_hints,"externalAmbushSites":game.ground_combat.ambush_sites.size()})

func geometry_checks(stage: Dictionary,expected: Dictionary) -> void:
	scope=str(stage.id)
	check(immutable(stage)==expected,"All balance, costs, objectives, learning/save IDs and lane identities are unchanged")
	var history: Dictionary=stage.historicalBattlefield
	check(history.sourceStageId==stage.id,"Historical source joins the same saved stage")
	check(history.sceneLandmarks.size()>=stage.objectives.size(),"Native terrain contains the actual defended objectives")
	check(not history.sceneLandmarks.is_empty() and not str(history.materialTheme).is_empty(),"Actual3D landmark and material contract is explicit")
	check(stage.camera.allowZoom==(int(stage.stageNumber) in [10,15,18,20,21,23,25,26,28,30,37,38,39,40]),"Zoom is limited to the authored large siege/fort fields")
	for feature in history.heightFeatures:
		check(float(feature.amplitudeWorld)>=.4 and float(feature.amplitudeWorld)<=1.4,"Relief uses bounded game-scale heights")
	var source: String=JSON.stringify(stage)
	var game: Node2D=make_game(stage)
	check(game.paths.size()==stage.paths.size() and game.ground_combat.march_bases.size()==stage.paths.size(),"Every lane loads and has a real sortie base")
	var common: Vector2=point(stage.commonEnemyEntry)
	var branch: Vector2=point(stage.commonEnemyEntry.branchPoint)
	for path_index in range(game.paths.size()):
		var route: Array=game.paths[path_index].points
		check(route.size()>=3 and route[0].is_equal_approx(common) and route[1].is_equal_approx(branch),"All ordinary enemies use the same entry then land branch "+str(path_index))
		for segment in range(route.size()-1):
			check(route[segment].is_finite() and Rect2(Vector2.ZERO,Vector2.ONE).grow(.00001).has_point(route[segment]),"Route is finite and normalized")
			check(game.ground_combat.land_segment_safe(route[segment],route[segment+1],.008),"Actual route cannot cross water or blocking terrain "+str(path_index)+"/"+str(segment))
		var entry: Dictionary=game._prepared_ambush_entry(path_index)
		check(not entry.is_empty(),"Every lane provides a prepared hunter side ingress "+str(path_index))
		if not entry.is_empty():
			check(not game._on_road(entry.points[0]),"Hunter begins on a separately marked side path")
			for segment in range(entry.points.size()-1):
				check(game.ground_combat.land_segment_safe(entry.points[segment],entry.points[segment+1],.008),"Hunter ingress follows actual land")
			check(game.ground_combat.route_point(path_index,float(entry.joinDistance)).distance_to(entry.points[-1])<.00001,"Side ingress joins the real route without teleportation")
		var enemy: Dictionary=game._spawn_enemy("raider",1,{"pathIndex":path_index})
		check(enemy.position.distance_to(common)<.025,"Ordinary native enemy actually appears at the common entrance")
		game.enemies.clear()
	area_checks(game,stage)
	for site in game.ground_combat.ambush_sites:
		check(not game._on_road(site.position) and game.ground_combat.land_segment_safe(site.position,site.entryPosition),"Ninja has a real external land approach")
	check(not game.ground_combat.ambush_sites.is_empty(),"External ninja deployment remains possible")
	check(JSON.stringify(stage)==source,"Production load/preview does not mutate the source map")
	game.free()
	for minutes in [10,20]:
		game=make_game(stage,minutes)
		var snapshot: Dictionary=game.snapshot()
		check(snapshot.battleMinutes==minutes and is_equal_approx(float(snapshot.battleTargetSeconds),minutes*60.0),"10/20minute plan retains its exact simulation-clock deadline")
		game.free()

func recruit_check(stage: Dictionary,type_name: String) -> void:
	scope=str(stage.id)+" "+type_name
	var game: Node2D=make_game(stage)
	game.gold=10000
	var wallet: int=game.gold
	var paid: int=game.recruit_cost(type_name)
	var contract: Dictionary=game.placement_contract(type_name)
	check(game.begin_placement(type_name),"Real native deployment begins")
	if str(contract.deploymentKind)!="marching":
		check(game.gold==wallet and game.recruitment_queue.is_empty(),"Selecting a placed role is free")
		var position: Vector2=Vector2(-1,-1)
		for zone in game.zones:
			position=game._zone_placement_hint(zone,type_name)
			if position.x>=0: break
		check(position.x>=0,"Role has a real legal deployment position")
		if position.x>=0:
			check(game.placement_preview(position).valid,"Production preview accepts that land point")
			check(game.place_unit(position.x,position.y),"The legal click commits one paid order")
			check(not game.place_unit(position.x,position.y),"Repeated click cannot purchase twice")
	check(game.recruitment_queue.size()==1 and game.gold==wallet-paid,"One order debits its existing level1 cost once")
	if game.recruitment_queue.is_empty(): game.free();return
	var waiting: String=JSON.stringify(game.snapshot().recruitmentQueue)
	game.running=true
	game.paused=true
	game.advance_simulation(3)
	check(JSON.stringify(game.snapshot().recruitmentQueue)==waiting,"Explicit pause freezes paid production")
	game.paused=false
	game.between_waves=true
	game.advance_simulation(3)
	check(JSON.stringify(game.snapshot().recruitmentQueue)==waiting,"Learning/intermission freezes production")
	game.between_waves=false
	wait_for_production(game)
	check(game.units.size()==1 and game.recruitment_queue.is_empty(),"Ordinary world time creates exactly one level1 actor")
	check(game.gold==wallet-paid,"Completion does not debit a second cost")
	if not game.units.is_empty():
		var unit: Dictionary=game.units[0]
		check(str(unit.type)==type_name and int(unit.campaignLevel)==1,"Generated actor preserves its real role and level")
		check(game.ground_combat.land_segment_safe(unit.position,unit.position,.008),"Generated actor stands on land")
		if str(contract.deploymentKind)=="marching":
			var start: Vector2=unit.position
			for tick in range(140):
				var previous: Vector2=unit.position
				game.advance_simulation(.025)
				check(game.ground_combat.land_segment_safe(previous,unit.position),"Real sortie steps remain on land")
			check(unit.position.distance_to(start)>.008,"Marching role walks out after bounded gathering")
		else:
			check(not game.placement_contract(type_name).deploymentKind=="marching","Guard/support/ambush remains a placed role")
	game.free()

func support_checks(stage: Dictionary,plan: Dictionary) -> void:
	scope=str(stage.id)+" learning support"
	var game: Node2D=make_game(stage)
	hold(game)
	var wallet: int=game.gold
	for mission in plan.get("missions",[]):
		var anchor: Dictionary=stage.historicalBattlefield.learningSupportAnchors.get(str(mission.id),mission.action.position)
		var position: Vector2=point(anchor)
		check(game.ground_combat.land_segment_safe(position,position,.008),"Original/mission-keyed support anchor stays on land "+str(mission.id))
		if stage.historicalBattlefield.learningSupportAnchors.has(str(mission.id)):
			var usable: bool=false
			for zone in game.zones:
				if str(zone.placementRole)!="ambush" and position.distance_to(zone.position)<=float(zone.r): usable=true
			check(usable,"Remapped mission support reaches an actual friendly deployment area")
		var support: Dictionary=game.apply_learning_support(position,false,str(mission.id))
		check(support.get("ok")==true and is_equal_approx(float(support.get("duration",0)),12),"Actual support applies once with the preserved12second duration")
		var count: int=game.learning_supports.size()
		check(game.apply_learning_support(position,false,str(mission.id)).get("ok")==false and game.learning_supports.size()==count,"Duplicate mission answer creates no second support")
	check(game.gold==wallet,"Support location changes add no unauthorized money")
	game.free()

func run() -> void:
	var maps: Array=JSON.parse_string(FileAccess.get_file_as_string("res://native/maps.json"))
	var original: Dictionary=JSON.parse_string(ORIGINAL_CONTRACTS)
	var plans: Dictionary=JSON.parse_string(FileAccess.get_file_as_string("res://native/learning_plans.json"))
	catalog=JSON.parse_string(FileAccess.get_file_as_string("res://native/units.json")).units
	var plan_hash: String=FileAccess.get_sha256("res://native/learning_plans.json")
	check(maps.size()==40 and original.size()==40,"All40 saved stages are represented")
	for stage in maps:
		print("HISTORICAL_SCENE stage="+str(stage.stageNumber)+"/40 "+str(stage.id))
		geometry_checks(stage,original[str(stage.id)])
		support_checks(stage,plans.stages.get(str(stage.id),{}))
		if not OS.get_cmdline_user_args().has("--geometry-only"):
			for type_name in TYPES: recruit_check(stage,str(type_name))
		await process_frame
	check(plan_hash==FileAccess.get_sha256("res://native/learning_plans.json"),"900word/SRS/context source remains untouched")
	var path: String="user://qa_historical_scene_geometry.json" if OS.get_cmdline_user_args().has("--packed") else "res://tests/qa_historical_scene_geometry.json"
	var file: FileAccess=FileAccess.open(path,FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"failures":failures,"mapsSha256":FileAccess.get_sha256("res://native/maps.json"),"observations":observations},"\t"))
	file.close()
	print("HISTORICAL_SCENE_QA checks="+str(checks)+" failures="+str(failures.size()))
	quit(0 if failures.is_empty() else 1)
