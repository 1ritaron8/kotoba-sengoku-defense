extends Node3D
## Rigid joint weights retain the authored geometry and procedural IK exactly.
## A flattened deformation palette renders one surface per visibility group.
static var cache: Dictionary = {}
var skeleton: Skeleton3D
var joint_names: Array = []
var joint_nodes: Array[Node3D] = []
var joint_parents: PackedInt32Array = PackedInt32Array()
var joint_poses: Array[Transform3D] = []
var groups: Dictionary = {}

func build(actor: Node3D, identity: String) -> void:
	skeleton = Skeleton3D.new()
	skeleton.name = "JointPalette"
	add_child(skeleton)
	var skin = Skin.new()
	for key in actor.bones:
		var index: int = joint_names.size()
		joint_names.append(key)
		joint_nodes.append(actor.bones[key])
		skeleton.add_bone(str(key))
		skeleton.set_bone_rest(index,Transform3D.IDENTITY)
		skin.add_bind(index,Transform3D.IDENTITY)
	for joint in joint_nodes:
		var parent_index: int = joint_nodes.find(joint.get_parent())
		joint_parents.append(parent_index)
		joint_poses.append(Transform3D.IDENTITY)
	if not cache.has(identity):
		var builders: Dictionary = {}
		var rest_palette: Array = []
		var inverse: Transform3D = actor.global_transform.affine_inverse()
		for key in joint_names:
			rest_palette.append(inverse*actor.bones[key].global_transform)
		for source in actor.meshes:
			var bone_name: String = str(source.get_parent().name)
			var group: String = "boat" if bone_name in ["boat","oarL","oarR"] else "mount" if bone_name=="mount" or bone_name.begins_with("horse") else "weapon" if bone_name=="weapon" else "body"
			if not builders.has(group):
				var builder = SurfaceTool.new()
				builder.begin(Mesh.PRIMITIVE_TRIANGLES)
				builder.set_custom_format(0,SurfaceTool.CUSTOM_RGBA_FLOAT)
				builders[group] = builder
			var bone_index: int = joint_names.find(bone_name)
			for surface in range(source.mesh.get_surface_count()):
				var arrays: Array = source.mesh.surface_get_arrays(surface)
				var vertex_count: int = (arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
				var indices = PackedInt32Array()
				var weights = PackedFloat32Array()
				indices.resize(vertex_count*4)
				weights.resize(vertex_count*4)
				for vertex in range(vertex_count):
					indices[vertex*4] = bone_index
					weights[vertex*4] = 1.0
				arrays[Mesh.ARRAY_BONES] = indices
				arrays[Mesh.ARRAY_WEIGHTS] = weights
				var weighted = ArrayMesh.new()
				weighted.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays,[],{},source.mesh.surface_get_format(surface))
				builders[group].append_from(weighted,0,source.transform)
		var meshes: Dictionary = {}
		for group in builders:
			builders[group].index()
			var combined: ArrayMesh = builders[group].commit()
			var importer = ImporterMesh.new()
			importer.add_surface(Mesh.PRIMITIVE_TRIANGLES,combined.surface_get_arrays(0),[],{},null,"",combined.surface_get_format(0))
			# Error-based LOD only affects screen-sized battlefield geometry.
			# Preserve full-resolution vertices and the rigid joint attributes;
			# simplify in the anatomically placed rest palette, not overlapping
			# joint-local coordinates. Portraits continue using full detail.
			importer.generate_lods(60,25,rest_palette)
			# Coarse autogenerated levels can discard feet and deform the horse
			# silhouette. Keep only fine reductions, including in shadow passes.
			var lods: Dictionary = {}
			var arrays: Array = combined.surface_get_arrays(0)
			var contact_bones: Dictionary = {}
			for key in ["footL","footR","horse_calf0","horse_calf1","horse_calf2","horse_calf3"]:
				var index: int = joint_names.find(key)
				if index>=0: contact_bones[index] = true
			var preserved: PackedInt32Array = _contact_indices(arrays,contact_bones)
			for level in range(importer.get_surface_lod_count(0)):
				var edge_length: float = importer.get_surface_lod_size(0,level)
				if edge_length<=.12:
					lods[edge_length] = _preserve_contacts(importer.get_surface_lod_indices(0,level),arrays,contact_bones,preserved)
			meshes[group] = _render_mesh(arrays,lods,combined.surface_get_format(0))
		cache[identity] = meshes
	for group in cache[identity]:
		var instance = MeshInstance3D.new()
		instance.name = "Skinned_"+str(group)
		instance.mesh = cache[identity][group]
		instance.material_override = actor.materials.combined
		instance.skin = skin
		instance.skeleton = NodePath("../JointPalette")
		instance.layers = 3
		instance.custom_aabb = AABB(Vector3(-2.5,-.3,-2.5),Vector3(5,4.3,5))
		add_child(instance)
		groups[group] = instance
	for source in actor.meshes:
		source.hide()
		# These meshes only supply authored vertices to contact IK and QA.
		# Their transforms are still computed on demand from the joint tree;
		# uploading every invisible piece to RenderingServer is unnecessary.
		source.set_notify_transform(false)
	sync_pose(actor)

func _contact_indices(arrays: Array, contact_bones: Dictionary) -> PackedInt32Array:
	var indices: PackedInt32Array = arrays[Mesh.ARRAY_INDEX]
	var bones: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
	var result: PackedInt32Array = PackedInt32Array()
	for corner in range(0,indices.size(),3):
		if contact_bones.has(bones[indices[corner]*4]):
			result.append(indices[corner])
			result.append(indices[corner+1])
			result.append(indices[corner+2])
	return result

func _render_mesh(source: Array, lods: Dictionary, format_value: int) -> ArrayMesh:
	# The authored mesh is always the base. Replacing it with an imported LOD
	# permanently discarded fine armour, face and limb geometry even up close.
	# Godot may still select a fine LOD dynamically for small distant soldiers.
	var arrays: Array = source.duplicate()
	var vertex_count: int = (source[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
	var source_indices: PackedInt32Array = source[Mesh.ARRAY_INDEX]
	var mesh = ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES,arrays,[],lods,format_value)
	mesh.set_meta("authored_vertex_count",vertex_count)
	mesh.set_meta("authored_triangle_count",source_indices.size()/3)
	mesh.set_meta("base_lod_error",0.0)
	return mesh

func _remap_indices(indices: PackedInt32Array, remap: Dictionary) -> PackedInt32Array:
	var result: PackedInt32Array = PackedInt32Array()
	result.resize(indices.size())
	for index in range(indices.size()):
		result[index] = int(remap[indices[index]])
	return result

func _preserve_contacts(indices: PackedInt32Array, arrays: Array, contact_bones: Dictionary, preserved: PackedInt32Array) -> PackedInt32Array:
	if preserved.is_empty(): return indices
	var bones: PackedInt32Array = arrays[Mesh.ARRAY_BONES]
	var result: PackedInt32Array = PackedInt32Array()
	for corner in range(0,indices.size(),3):
		if not contact_bones.has(bones[indices[corner]*4]):
			result.append(indices[corner])
			result.append(indices[corner+1])
			result.append(indices[corner+2])
	# Keep the authored sole/calf geometry even when the torso uses fewer
	# triangles. Contact IK and visible feet therefore use the same surface.
	result.append_array(preserved)
	return result

func sync_pose(actor: Node3D) -> void:
	for index in range(joint_names.size()):
		# Rig bones are created parent first. Compose actor-local matrices
		# directly; fetching every global transform repeats scene-tree work.
		var pose: Transform3D = joint_nodes[index].transform
		var parent_index: int = joint_parents[index]
		if parent_index>=0:
			pose = joint_poses[parent_index]*pose
		if pose==joint_poses[index]:
			continue
		joint_poses[index] = pose
		# The palette has no parent bones, so a precomputed local pose is its
		# global pose. The global setter recalculates all dirty bones on each
		# call; the local setter lets Godot upload the whole palette once.
		skeleton.set_bone_pose(index,pose)
	groups.body.visible = actor.rig.visible
	if groups.has("weapon"): groups.weapon.visible = actor.bones.weapon.visible
	if groups.has("mount"): groups.mount.visible = actor.mount.visible
	if groups.has("boat"): groups.boat.visible = actor.boat.visible
	for instance in groups.values():
		if instance.material_override!=actor.materials.combined:
			instance.material_override = actor.materials.combined
		instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if actor.sailing_visual or actor.has_meta("placement_preview") else GeometryInstance3D.SHADOW_CASTING_SETTING_ON

func visible_batches() -> int:
	var count: int = 0
	for instance in groups.values():
		if instance.is_visible_in_tree(): count += 1
	return count
